# ── pdf_pipeline 환경변수 샘플 ─────────────────────────────────
# 실제 값은 .env 에 저장 (gitignore). 이 파일은 샘플/문서용.

# Supabase
SUPABASE_URL=https://grukqugorspbwsxqdhru.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# 업로드 경로 (프로젝트 루트 기준 상대)
UPLOAD_DIR=backend/pdf_pipeline/uploads

# ── VL 모델 (이미지 → 상세정보 추출) ──────────────────────────
# 서버 배포 (RTX 4090 24GB, 정확도 우선) — 평일 업무시간 default
VL_OLLAMA_URL=http://localhost:11434
VL_MODEL=gemma4:26b
VL_TIMEOUT=180

# 그 외 시간대는 provider_selector 가 Gemini / OpenAI 로 auto-select

# ── 임베딩 (bge-m3 via Ollama) ────────────────────────────────
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# ── Call B skeleton 후처리 (2026-04-24) ──────────────────────
# Pass 1 repetition 폭주 방어용 상한 (dedupe 후 잘림)
CALL_B_MAX_SKELETON_STEPS=8

# ── 막힌 지점 도우미 (RAG 튜터) ───────────────────────────────
# 학생 JWT 검증용 anon 키 (POST /api/tutor/hint 인증). Supabase 대시보드 > Project Settings > API
SUPABASE_ANON_KEY=replace-me
# localize/generate 멀티모달 호출은 GPT-4o 강제 — OpenAI 키 필수
OPENAI_API_KEY=replace-me
# 튜터 힌트 VL provider (기본 openai — 한국어/도형 품질). ollama 로 바꾸면 gemma4 사용
TUTOR_VL_PROVIDER=openai
# 한 문제당 추론 노드 상한 (rag_node_extractor)
RAG_MAX_NODES=15
