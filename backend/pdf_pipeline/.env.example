# ── pdf_pipeline 환경변수 샘플 ─────────────────────────────────
# 실제 값은 .env 에 저장 (gitignore). 이 파일은 샘플/문서용.

# Supabase
SUPABASE_URL=https://grukqugorspbwsxqdhru.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# 업로드 경로 (프로젝트 루트 기준 상대)
UPLOAD_DIR=backend/pdf_pipeline/uploads

# ── VL 모델 (이미지 → 상세정보 추출) ──────────────────────────
# 서버 배포 (RTX 4090 24GB, 정확도 우선) — 평일 업무시간 default
VL_OLLAMA_URL=http://localhost:11434
VL_MODEL=gemma3:27b
VL_TIMEOUT=180

# 그 외 시간대는 provider_selector 가 Gemini / OpenAI 로 auto-select

# ── 임베딩 (bge-m3 via Ollama) ────────────────────────────────
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
