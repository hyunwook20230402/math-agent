# ── pdf_pipeline 환경변수 샘플 ─────────────────────────────────
# 실제 값은 .env 에 저장 (gitignore). 이 파일은 샘플/문서용.

# Supabase
SUPABASE_URL=https://grukqugorspbwsxqdhru.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# 업로드 경로 (프로젝트 루트 기준 상대)
UPLOAD_DIR=backend/pdf_pipeline/uploads

# ── VL 모델 (이미지 → 상세정보 추출) ──────────────────────────
# 2026-06-19: gemma4(ollama)/gemini 폐기. VL 은 OpenAI 단일.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o

# ── 임베딩 (bge-m3 via Ollama) — VL 과 달리 그대로 유지 ────────
# (OpenAI 임베딩은 1536차원이라 바꾸면 전체 재임베딩 필요 → 안 함. 항상 ollama.)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# ── Call B skeleton 후처리 ───────────────────────────────────
# Pass 1 step 수 상한 (dedupe 후 잘림)
CALL_B_MAX_SKELETON_STEPS=8

# ── 막힌 지점 도우미 (RAG 튜터) ───────────────────────────────
# 학생 JWT 검증용 anon 키 (POST /api/tutor/hint 인증). Supabase 대시보드 > Project Settings > API
SUPABASE_ANON_KEY=replace-me
# 한 문제당 추론 노드 상한 (rag_node_extractor)
RAG_MAX_NODES=15
