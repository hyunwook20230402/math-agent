{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(git *)",
      "Bash(python *)",
      "Bash(pip install:*)",
      "Bash(pip show:*)",
      "Bash(npx tsc:*)",
      "Bash(npx --prefix apps/cms tsc --noEmit)",
      "Bash(grep -E \"\\\\.\\(tsx?|json\\)$\")",
      "Bash(npx vite:*)",
      "Bash(netstat -ano)",
      "Bash(node_modules/.bin/tsc --noEmit)",
      "Bash(node_modules/.bin/tsc --project apps/cms/tsconfig.json --noEmit)",
      "Bash(echo \"exit: $?\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -q -- \"--no-verify\"; then echo \"BLOCK: --no-verify 사용 금지 (git hook 우회 불가)\"; exit 2; fi'"
          }
        ]
      }
    ]
  }
}
